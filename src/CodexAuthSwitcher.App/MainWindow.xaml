<Window x:Class="CodexAuthSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:CodexAuthSwitcher.App"
        xmlns:vm="clr-namespace:CodexAuthSwitcher.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static app:App.Localization}, Path=[Window.Main.Title]}"
        Width="1220"
        Height="780"
        MinWidth="1080"
        MinHeight="680"
        Background="#F4F7FB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#EEF4FF" />
            <Setter Property="Foreground" Value="#173B7A" />
            <Setter Property="BorderBrush" Value="#BFD3F7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#1E5BD8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1E5BD8" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#11284C"
                           Text="{Binding Source={x:Static app:App.Localization}, Path=[Header.Title]}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="#4F637E"
                           Text="{Binding Source={x:Static app:App.Localization}, Path=[Header.Subtitle]}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel Margin="0,0,16,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding SetChineseCommand}"
                            Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Chinese]}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChineseSelected}" Value="True">
                                        <Setter Property="Background" Value="#173B7A" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#173B7A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetEnglishCommand}"
                            Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.English]}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnglishSelected}" Value="True">
                                        <Setter Property="Background" Value="#173B7A" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="#173B7A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Refresh]}" />
                <Button Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding CaptureCurrentCommand}"
                        Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.CaptureChatGpt]}" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NewApiProfileCommand}"
                        Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.NewApiProfile]}" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1"
                     Rows="1"
                     Columns="4"
                     Margin="0,0,0,18">
            <Border Margin="0,0,12,0" Background="White">
                <StackPanel>
                    <TextBlock Foreground="#61748E"
                               Text="{Binding Source={x:Static app:App.Localization}, Path=[Card.CodexHome]}" />
                    <TextBlock Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="#132B54"
                               Text="{Binding CodexHomePath}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,0" Background="White">
                <StackPanel>
                    <TextBlock Foreground="#61748E"
                               Text="{Binding Source={x:Static app:App.Localization}, Path=[Card.CurrentAuth]}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#132B54"
                               Text="{Binding CurrentAuthDisplayText}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#61748E"
                               Text="{Binding CurrentIdentityPrimaryText}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#61748E"
                               Text="{Binding CurrentIdentitySecondaryText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,0" Background="White">
                <StackPanel>
                    <TextBlock Foreground="#61748E"
                               Text="{Binding Source={x:Static app:App.Localization}, Path=[Card.CurrentProfile]}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#132B54"
                               Text="{Binding CurrentProfileDisplayName}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#61748E"
                               Text="{Binding CurrentProfileKindDisplayText}" />
                </StackPanel>
            </Border>

            <Border Background="White">
                <StackPanel>
                    <TextBlock Foreground="#61748E"
                               Text="{Binding Source={x:Static app:App.Localization}, Path=[Card.DesktopCodex]}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#132B54"
                               Text="{Binding DesktopCodexStatusText}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#61748E"
                               Text="{Binding ModelProviderDisplayText}" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#61748E"
                               Text="{Binding ModelDisplayText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#132B54"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Section.Profiles]}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#61748E"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Section.Profiles.Subtitle]}" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        Background="#F7FAFE"
                                        BorderBrush="#D7E3F4"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="#11284C"
                                                       Text="{Binding Name}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="#47627E"
                                                       Text="{Binding Subtitle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="#73859A"
                                                       Text="{Binding Detail}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <Border Padding="8,4"
                                                    Background="#E7F0FF"
                                                    BorderBrush="#C8D9F8"
                                                    BorderThickness="1"
                                                    CornerRadius="999">
                                                <TextBlock Foreground="#2350A9"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding KindLabel}" />
                                            </Border>
                                            <Border Margin="0,8,0,0"
                                                    Padding="8,4"
                                                    Background="#E8F7EB"
                                                    BorderBrush="#BFE0C6"
                                                    BorderThickness="1"
                                                    CornerRadius="999"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Foreground="#2F7A3E"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding CurrentLabel}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#132B54"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Section.SelectedProfile]}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#61748E"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Section.SelectedProfile.Subtitle]}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Foreground="#61748E" Text="{Binding Source={x:Static app:App.Localization}, Path=[Common.Name]}" />
                        <TextBlock Grid.Column="1"
                                   FontWeight="SemiBold"
                                   Foreground="#132B54"
                                   Text="{Binding SelectedProfileDisplayName}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Foreground="#61748E"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Common.Kind]}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="#132B54"
                                   Text="{Binding SelectedProfileKindText}" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,14,0,0"
                                   Foreground="#61748E"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Common.Identity]}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="#132B54"
                                   Text="{Binding SelectedProfileIdentityText}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3"
                                   Margin="0,14,0,0"
                                   Foreground="#61748E"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Common.Details]}" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   Foreground="#425A77"
                                   Text="{Binding SelectedProfileDetailText}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="4"
                                   Margin="0,14,0,0"
                                   Foreground="#61748E"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Common.CurrentAuth]}" />
                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   Foreground="#425A77"
                                   Text="{Binding CurrentAuthDisplayText}" />

                        <TextBlock Grid.Row="5"
                                   Margin="0,14,0,0"
                                   Foreground="#61748E"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Common.ThreadLibrary]}" />
                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   Foreground="#425A77"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Section.ThreadLibraryValue]}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,20,0,0">
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding EditSelectedProfileCommand}"
                                Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Edit]}" />
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding DeleteSelectedProfileCommand}"
                                Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Delete]}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SwitchSelectedProfileCommand}"
                                Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.SwitchToSelected]}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Background="#11284C"
                Padding="14,12">
            <Grid>
                <TextBlock Foreground="White"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" />
                <ProgressBar Width="160"
                             Height="10"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
