<Window x:Class="CodexAuthSwitcher.App.Views.ApiProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:CodexAuthSwitcher.App"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="760"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF0F172A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF38BDF8" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FF94A3B8" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1F2937" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#FF334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Resources>

    <Border Margin="18" Padding="18" Background="{StaticResource PanelBrush}" CornerRadius="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding HeaderSubtitle}"
                               Foreground="{StaticResource SubtleBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.ProfileName]}" />
                        <TextBox Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.Provider]}" />
                        <TextBox Text="{Binding Profile.Provider, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.BaseUrl]}" />
                        <TextBox Text="{Binding Profile.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.Model]}" />
                        <TextBox Text="{Binding Profile.Model, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.ReasoningEffort]}" />
                        <TextBox Text="{Binding Profile.ReasoningEffort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.WireApi]}" />
                        <TextBox Text="{Binding Profile.WireApi, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.RequiresOpenAiAuth]}" />
                        <CheckBox IsChecked="{Binding Profile.RequiresOpenAiAuth}"
                                  Content="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.RequiresOpenAiAuth.Checkbox]}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.UseOpenAiThreadView]}" />
                        <CheckBox IsChecked="{Binding Profile.UseOpenAiThreadView}"
                                  Content="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.UseOpenAiThreadView.Checkbox]}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.TokenLimit]}" />
                        <TextBox Text="{Binding Profile.ModelAutoCompactTokenLimit, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.ApiEditor.ApiKey]}" />
                        <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Cancel]}" Click="Cancel_Click" />
                    <Button Content="{Binding ConfirmButtonText}"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            BorderBrush="{StaticResource AccentBrush}"
                            Click="Confirm_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
