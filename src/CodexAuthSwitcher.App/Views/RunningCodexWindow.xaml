<Window x:Class="CodexAuthSwitcher.App.Views.RunningCodexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:CodexAuthSwitcher.App"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static app:App.Localization}, Path=[Window.RunningCodex.Title]}"
        Width="540"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF0F172A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFF59E0B" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FF94A3B8" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>

    <Border Margin="18" Padding="18" Background="{StaticResource PanelBrush}" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Window.RunningCodex.Title]}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.RunningCodex.Header]}"
                           Foreground="{StaticResource SubtleBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <Border Background="#1AFFFFFF" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.RunningCodex.Recommended]}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.RunningCodex.RecommendedBody]}"
                                   Foreground="{StaticResource SubtleBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Cancel]}" Click="Cancel_Click" />
                <Button Content="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.RunningCodex.ManualClose]}"
                        Background="#FF334155"
                        Foreground="White"
                        BorderBrush="#FF334155"
                        Click="ManualClose_Click" />
                <Button Content="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.RunningCodex.AutoClose]}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}"
                        Click="AutoClose_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
