<Window x:Class="CodexAuthSwitcher.App.Views.SnapshotNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:CodexAuthSwitcher.App"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static app:App.Localization}, Path=[Window.Snapshot.Title]}"
        Width="480"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF0F172A"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF111827" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF38BDF8" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FF94A3B8" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1F2937" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#FF334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Resources>

    <Border Margin="18" Padding="18" Background="{StaticResource PanelBrush}" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Window.Snapshot.Title]}"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.Snapshot.Header]}"
                           Foreground="{StaticResource SubtleBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="{Binding Source={x:Static app:App.Localization}, Path=[Dialog.Snapshot.Name]}" Margin="0,0,0,8" />
                <TextBox x:Name="NameBox"
                         Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         Loaded="NameBox_Loaded" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Cancel]}" Click="Cancel_Click" />
                <Button Content="{Binding Source={x:Static app:App.Localization}, Path=[Common.Save]}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
